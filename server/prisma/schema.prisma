generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StatusUsuario {
  ATIVO
  INATIVO
  BANIDO
}

enum StatusRegistro {
  ATIVO
  INATIVO
}

enum Genero {
  MASCULINO
  FEMININO
  OUTRO
}

enum GeneroCategoria {
  MASCULINO
  FEMININO
  LIVRE
}

enum StatusOrganizador {
  PENDENTE
  APROVADO
  REJEITADO
  SUSPENSO
}

enum StatusEvento {
  RASCUNHO
  AGUARDANDO_APROVACAO
  PUBLICADO
  INSCRICOES_ENCERRADAS
  CANCELADO
  FINALIZADO
  SUSPENSO
}

enum StatusInscricao {
  PENDENTE_PAGAMENTO
  CONFIRMADA
  CANCELADA
  EXPIRADA
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  ESTORNADO
  CANCELADO
  EXPIRADO
}

enum StatusResultado {
  FINALIZADO
  DNF
  DNS
  DESCLASSIFICADO
}

enum StatusSolicitacaoArte {
  PENDENTE_PAGAMENTO
  PAGO
  EM_PRODUCAO
  ENTREGUE
  CANCELADO
}

// ---------------------------------------------------------------------------
// Identidade e perfil
// ---------------------------------------------------------------------------

model Usuario {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String        @unique
  passwordHash       String
  emailVerificado    Boolean       @default(false)
  emailToken         String?
  emailTokenExpiraEm DateTime?
  resetToken         String?
  resetTokenExpiraEm DateTime?
  status             StatusUsuario @default(ATIVO)
  ultimoLogin        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  cliente Cliente?
}

model Cliente {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String         @unique @db.Uuid
  fotoPerfil String?
  status     StatusRegistro @default(ATIVO)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  pf          ClientePf?
  pj          ClientePj?
  enderecos   Endereco[]
  organizador Organizador?
  inscricoes  Inscricao[]
  dependentes Dependente[]
  pedidos     Pedido[]

  solicitacoesAlteracaoDocumento SolicitacaoAlteracaoDocumento[]
}

model ClientePf {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId       String   @unique @db.Uuid
  nomeCompleto    String
  cpf             String   @unique
  dataNascimento  DateTime @db.Date
  genero          Genero
  pcd             Boolean  @default(false)
  documentoPcdUrl String?
  celular         String
  nacionalidade   String   @default("Brasileira")

  cliente Cliente @relation(fields: [clienteId], references: [id])
}

model ClientePj {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId            String  @unique @db.Uuid
  razaoSocial          String
  nomeFantasia         String?
  cnpj                 String  @unique
  nomeResponsavel      String
  documentoResponsavel String
  celularComercial     String

  cliente Cliente @relation(fields: [clienteId], references: [id])
}

model Endereco {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId   String  @db.Uuid
  tipo        String?
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  pais        String  @default("Brasil")

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
}

model Organizador {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId              String            @unique @db.Uuid
  status                 StatusOrganizador @default(PENDENTE)
  plano                  String?
  comissaoPercentual     Decimal           @db.Decimal(5, 2)
  chavePix               String?
  /// Renda mensal (PF) ou faturamento mensal (PJ). Exigido pelo Asaas ao abrir a subconta.
  rendaFaturamentoMensal Decimal?          @db.Decimal(12, 2)
  /// E-mail da conta de recebimento no Asaas. O Asaas exige e-mail unico por
  /// conta, entao quem ja tem conta la precisa informar outro aqui.
  emailRecebimento       String?
  /// Natureza juridica da empresa. Exigido pelo Asaas quando o organizador e PJ.
  tipoEmpresa            TipoEmpresa?
  banco                  String?
  agencia                String?
  conta                  String?
  tipoConta              String?
  fotoRostoUrl           String?
  documentoIdentidadeUrl String?
  motivoRevisao          String?
  /// Conexao com o Mercado Pago. O organizador autoriza nosso app via OAuth e o
  /// dinheiro cai na conta dele; nos ficamos com a comissao (application_fee).
  mpUserId               String?           @unique
  mpAccessToken          String?
  mpRefreshToken         String?
  mpTokenExpiraEm        DateTime?
  mpConectadoEm          DateTime?

  /// Legado do Asaas. Mantido apenas para consulta historica de cobrancas
  /// antigas; nada no codigo escreve ou le mais esses campos.
  asaasAccountId String?  @unique
  asaasWalletId  String?
  asaasApiKey    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cliente          Cliente           @relation(fields: [clienteId], references: [id])
  eventos          Evento[]
  staff            Staff[]
  solicitacoesArte SolicitacaoArte[]
  saques           Saque[]
}

model Admin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  nome         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Eventos
// ---------------------------------------------------------------------------

model Evento {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizadorId           String       @db.Uuid
  nome                    String
  descricao               String?
  regulamentoUrl          String?
  bannerUrl               String?
  termoResponsabilidade   String?
  retiradaKitLocal        String?
  retiradaKitInicio       DateTime?
  retiradaKitFim          DateTime?
  limiteTrocaCamisaAté   DateTime?
  camisasBloqueadas       Boolean      @default(false)
  permiteTransferencia    Boolean      @default(true)
  apiKeyCronometragem     String?      @unique
  aplicaDescontoIdoso     Boolean      @default(false)
  percentualDescontoIdoso Decimal?     @db.Decimal(5, 2)
  taxaRepassadaAtleta     Boolean      @default(false)
  aceitaPix               Boolean      @default(true)
  aceitaCartao            Boolean      @default(true)
  dataInicio              DateTime
  dataFim                 DateTime
  local                   String
  cidade                  String
  estado                  String
  capacidade              Int?
  status                  StatusEvento @default(RASCUNHO)
  motivoRejeicao          String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  organizador      Organizador       @relation(fields: [organizadorId], references: [id])
  patrocinadores   Patrocinador[]
  modalidades      Modalidade[]
  lotes            Lote[]
  cupons           Cupom[]
  solicitacoesArte SolicitacaoArte[]

  @@index([status, dataInicio])
}

model Patrocinador {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId String  @db.Uuid
  nome     String
  logoUrl  String?
  site     String?

  evento Evento @relation(fields: [eventoId], references: [id])
}

model Staff {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizadorId String   @db.Uuid
  nome          String
  funcao        String?
  email         String   @unique
  passwordHash  String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizador Organizador @relation(fields: [organizadorId], references: [id])
}

model Modalidade {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId        String   @db.Uuid
  nome            String
  distanciaKm     Decimal  @db.Decimal(6, 2)
  descricao       String?
  idadeMinima     Int?
  idadeMaxima     Int?
  ativo           Boolean  @default(true)
  capacidade      Int?
  mapaPercursoUrl String?
  mapaEmbedUrl    String?
  gpxUrl          String?
  rotaGeoJson     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evento     Evento                @relation(fields: [eventoId], references: [id])
  categorias Categoria[]
  precos     LoteModalidadePreco[]
}

model Categoria {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modalidadeId String          @db.Uuid
  nome         String
  idadeMinima  Int?
  idadeMaxima  Int?
  genero       GeneroCategoria @default(LIVRE)
  pcd          Boolean         @default(false)
  capacidade   Int?

  modalidade Modalidade  @relation(fields: [modalidadeId], references: [id])
  inscricoes Inscricao[]
}

model Lote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId    String   @db.Uuid
  nome        String
  quantidade  Int?
  inicioVenda DateTime
  fimVenda    DateTime
  createdAt   DateTime @default(now())

  evento     Evento                @relation(fields: [eventoId], references: [id])
  precos     LoteModalidadePreco[]
  inscricoes Inscricao[]
}

// Preço de cada modalidade (produto) dentro de cada lote (janela de venda).
// Ex.: no 1º lote, 5km custa R$60 e 21km custa R$100.
model LoteModalidadePreco {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loteId       String  @db.Uuid
  modalidadeId String  @db.Uuid
  valor        Decimal @db.Decimal(10, 2)

  lote       Lote       @relation(fields: [loteId], references: [id])
  modalidade Modalidade @relation(fields: [modalidadeId], references: [id])

  @@unique([loteId, modalidadeId])
}

model Cupom {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId           String    @db.Uuid
  codigo             String
  percentualDesconto Decimal   @db.Decimal(5, 2)
  quantidadeMaxima   Int?
  usosAtuais         Int       @default(0)
  validoAte          DateTime?
  ativo              Boolean   @default(true)
  createdAt          DateTime  @default(now())

  evento     Evento      @relation(fields: [eventoId], references: [id])
  inscricoes Inscricao[]

  @@unique([eventoId, codigo])
}

// ---------------------------------------------------------------------------
// Inscrição, Dependentes e Pedidos
// ---------------------------------------------------------------------------

model Dependente {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId      String   @db.Uuid
  nomeCompleto   String
  cpf            String
  dataNascimento DateTime @db.Date
  genero         Genero
  pcd            Boolean  @default(false)
  celular        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cliente    Cliente     @relation(fields: [clienteId], references: [id])
  inscricoes Inscricao[]

  @@unique([clienteId, cpf])
  @@index([clienteId])
}

model Pedido {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente    Cliente     @relation(fields: [clienteId], references: [id])
  inscricoes Inscricao[]
  pagamentos Pagamento[]

  @@index([clienteId])
}

model Inscricao {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId    String  @db.Uuid
  categoriaId  String  @db.Uuid
  loteId       String  @db.Uuid
  cupomId      String? @db.Uuid
  pedidoId     String? @db.Uuid
  dependenteId String? @db.Uuid

  // Dados do atleta participante (caso seja diferente do próprio titular)
  atletaNome           String?
  atletaCpf            String?
  atletaDataNascimento DateTime? @db.Date
  atletaGenero         Genero?
  atletaPcd            Boolean   @default(false)

  numeroPeito   String?
  tamanhoCamisa String?
  kitEntregueEm DateTime?
  dataInscricao DateTime        @default(now())
  status        StatusInscricao @default(PENDENTE_PAGAMENTO)

  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  dependente  Dependente?  @relation(fields: [dependenteId], references: [id])
  pedido      Pedido?      @relation(fields: [pedidoId], references: [id])
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  lote        Lote         @relation(fields: [loteId], references: [id])
  cupom       Cupom?       @relation(fields: [cupomId], references: [id])
  pagamentos  Pagamento[]
  certificado Certificado?
  resultado   Resultado?

  @@index([status])
  @@index([pedidoId])
}

// 1 inscrição (ou 1 pedido agrupado) pode ter N tentativas de pagamento.
model Pagamento {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inscricaoId      String?         @db.Uuid
  pedidoId         String?         @db.Uuid
  valor            Decimal         @db.Decimal(10, 2)
  metodo           MetodoPagamento
  status           StatusPagamento @default(PENDENTE)
  gateway          String?
  codigoTransacao  String?
  gatewayPaymentId String?         @unique
  pixQrCodeUrl     String?
  pixCopiaECola    String?
  dataPagamento    DateTime?
  expiraEm         DateTime?
  /// Valor liquido informado pelo Asaas (valor - tarifa). So existe apos a
  /// confirmacao; nosso calculo sozinho nao conhece a tarifa do gateway.
  valorLiquido     Decimal?        @db.Decimal(10, 2)
  /// Tarifa cobrada pelo gateway nesta transacao.
  taxaGateway      Decimal?        @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())

  inscricao Inscricao? @relation(fields: [inscricaoId], references: [id])
  pedido    Pedido?    @relation(fields: [pedidoId], references: [id])

  @@index([inscricaoId, status])
  @@index([pedidoId, status])
}

// ---------------------------------------------------------------------------
// Solicitação de Arte / Configuração da Plataforma
// ---------------------------------------------------------------------------

model SolicitacaoArte {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventoId           String                @db.Uuid
  organizadorId      String                @db.Uuid
  status             StatusSolicitacaoArte @default(PENDENTE_PAGAMENTO)
  valor              Decimal               @db.Decimal(10, 2)
  observacoes        String?
  asaasPaymentId     String?               @unique
  pixQrCodeUrl       String?
  pixCopiaECola      String?
  dataPagamento      DateTime?
  arquivoEntregueUrl String?
  motivoCancelamento String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  evento      Evento      @relation(fields: [eventoId], references: [id])
  organizador Organizador @relation(fields: [organizadorId], references: [id])

  @@index([organizadorId, status])
  @@index([status])
}

// Config global da plataforma — 1 linha só (id fixo "default"), pra caber
// outros preços/parâmetros configuráveis no futuro sem criar tabela nova.
model ConfiguracaoPlataforma {
  id              String   @id @default("default")
  precoArteEvento Decimal  @default(150.00) @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt
}

model Certificado {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inscricaoId String   @unique @db.Uuid
  urlPdf      String
  dataEmissao DateTime @default(now())

  inscricao Inscricao @relation(fields: [inscricaoId], references: [id])
}

model Resultado {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inscricaoId          String          @unique @db.Uuid
  tempoBrutoSegundos   Int?
  tempoLiquidoSegundos Int?
  colocacaoGeral       Int?
  colocacaoCategoria   Int?
  colocacaoGenero      Int?
  status               StatusResultado @default(FINALIZADO)

  inscricao Inscricao @relation(fields: [inscricaoId], references: [id])
}

enum CategoriaAuditLog {
  FINANCEIRO
  SEGURANCA
  OPERACIONAL
  ASAAS_WEBHOOK
}

enum NivelAuditLog {
  INFO
  SUCCESS
  WARN
  ERROR
}

model AuditLog {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoria CategoriaAuditLog @default(OPERACIONAL)
  nivel     NivelAuditLog     @default(INFO)
  mensagem  String
  detalhes  Json?
  usuarioId String?           @db.Uuid
  ip        String?
  createdAt DateTime          @default(now())

  @@index([categoria])
  @@index([nivel])
  @@index([createdAt])
}

/// Espelha os valores aceitos pelo Asaas em `companyType` (POST /accounts),
/// obrigatorio quando a subconta e aberta com CNPJ.
enum TipoEmpresa {
  MEI
  LIMITED
  INDIVIDUAL
  ASSOCIATION
}

enum StatusSaque {
  PROCESSANDO
  CONCLUIDO
  FALHOU
}

/// Registra cada retirada solicitada pelo organizador, para que o saldo
/// disponivel possa ser calculado como (repasse aprovado - saques nao falhados).
model Saque {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizadorId String      @db.Uuid
  valor         Decimal     @db.Decimal(10, 2)
  status        StatusSaque @default(PROCESSANDO)
  chaveDestino  String
  transferId    String?     @unique
  motivoFalha   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  organizador Organizador @relation(fields: [organizadorId], references: [id])

  @@index([organizadorId, status])
}

enum StatusSolicitacaoDocumento {
  PENDENTE
  APROVADA
  REJEITADA
}

enum TipoDocumentoTitular {
  CPF
  CNPJ
}

/// CPF/CNPJ deixou de ser editavel direto no perfil: ele define para qual conta
/// o organizador pode sacar. Toda troca passa por aqui, com foto do documento e
/// aprovacao do admin, e congela os saques enquanto estiver pendente.
model SolicitacaoAlteracaoDocumento {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId      String                     @db.Uuid
  tipo           TipoDocumentoTitular
  documentoAtual String
  documentoNovo  String
  arquivoUrl     String
  motivo         String?
  status         StatusSolicitacaoDocumento @default(PENDENTE)
  motivoRejeicao String?
  revisadoEm     DateTime?
  revisadoPorId  String?                    @db.Uuid
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId, status])
  @@index([status])
}
